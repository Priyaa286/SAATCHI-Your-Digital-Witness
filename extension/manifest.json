{
  "manifest_version": 3,
  "name": "SAATCHI - Your Digital Witness",
  "version": "1.0",
  "description": "Capture tamper-proof evidence of online harassment in one click.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}